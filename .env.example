# Template for .env. `make setup` copies it and fills in SERVER_IP and LITELLM_MASTER_KEY;
# you fill in the rest. Read by the Makefile and docker compose (via make); any value can
# also be overridden on the command line (make flash PORT=/dev/cu.usbmodem2101).

# LAN IP of this Mac (filled in by make setup), and the server's HTTP/OTA port
SERVER_IP=
SERVER_OTA_PORT=8003

# Wi-Fi the board joins (2.4 GHz)
WIFI_SSID=my-wifi
WIFI_PASS=my-password

# Serial port of the board. It differs per laptop and USB socket: plug the board in and
# check with `ls /dev/cu.usb*`, then put the result here.
PORT=/dev/cu.usbmodem1101

# LiteLLM: master key the server and make chat use (generated by make setup),
# and your own key for the hai proxy
LITELLM_MASTER_KEY=
HAI_API_KEY=
LOCAL_AI_API_KEY=
